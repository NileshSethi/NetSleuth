# ==============================================================================
# NetSleuth - Environment Configuration Template (.env.example)
# ==============================================================================
# NetSleuth Phase 1 / MVP is designed to operate 100% locally with synthetic
# network-flow records (CSV format). No external cloud accounts, remote API keys,
# database credentials, or secret tokens are required or permitted for local execution.
#
# DO NOT place actual secrets, API tokens, or cloud credentials in this file.
# If future phases introduce optional external integrations (e.g., cloud export),
# duplicate this file as `.env` (which is git-ignored) and configure local settings.
# ==============================================================================

# Application Environment Mode (development | evaluation)
NETSLEUTH_ENV=development

# Optional UI & Log Level (DEBUG, INFO, WARNING, ERROR)
NETSLEUTH_LOG_LEVEL=INFO

# Default Path for Synthetic Data (relative to project root)
NETSLEUTH_DEFAULT_DATA_DIR=data/synthetic
